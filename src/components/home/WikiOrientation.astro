---
import { type Locale } from '~/i18n/routing';
import { localizePath } from '~/lib/url';

interface Topic {
  title: string;
  body: string;
  linkLabel: string;
  href: string;
}

interface Props {
  locale: Locale;
  content: {
    title: string;
    intro: string;
    topics: Topic[];
    noteTitle: string;
    note: string;
  };
}

const { locale, content } = Astro.props;
---

<section class="section border-t border-border" aria-labelledby="wiki-orientation-title">
  <div class="mx-auto max-w-5xl">
    <h2 id="wiki-orientation-title" class="text-2xl font-bold tracking-tight md:text-3xl">
      {content.title}
    </h2>
    <p class="mt-4 max-w-4xl leading-7 text-muted-foreground">{content.intro}</p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {content.topics.map((topic) => (
        <article class="card flex flex-col p-5 md:p-6">
          <h3 class="text-lg font-semibold leading-snug">{topic.title}</h3>
          <p class="mt-3 flex-1 leading-7 text-muted-foreground">{topic.body}</p>
          <a
            href={localizePath(topic.href, locale)}
            class="mt-4 inline-flex w-fit items-center font-medium text-foreground underline decoration-border underline-offset-4 hover:text-nav"
          >
            {topic.linkLabel}
          </a>
        </article>
      ))}
    </div>

    <aside class="mt-8 rounded-lg border border-border bg-muted/30 p-5 md:p-6">
      <h3 class="font-semibold">{content.noteTitle}</h3>
      <p class="mt-2 leading-7 text-muted-foreground">{content.note}</p>
    </aside>
  </div>
</section>
